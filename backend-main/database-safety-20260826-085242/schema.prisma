enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketCategory {
  GENERAL
  CONSULTATION
  PAYMENT
  WALLET
  ACCOUNT
  ASTROLOGER
  TECHNICAL
  ASSISTANT_ESCALATION
  OTHER
}

enum SupportSenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum AssistantConversationStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum AssistantSenderType {
  CUSTOMER
  ASSISTANT
  ADMIN
  SYSTEM
}

model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique

  customerId String

  subject     String
  description String?

  category SupportTicketCategory @default(GENERAL)
  priority SupportTicketPriority @default(NORMAL)
  status   SupportTicketStatus   @default(OPEN)

  assignedAdminId String?

  relatedCallSessionId String?
  relatedPaymentId     String?
  relatedWalletTxnId   String?

  lastMessageAt      DateTime?
  customerLastReadAt DateTime?
  adminLastReadAt    DateTime?

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User  @relation("SupportTicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assignedAdmin User? @relation("SupportTicketAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  messages SupportMessage[]

  assistantConversation AssistantConversation?

  @@index([customerId, createdAt])
  @@index([status, updatedAt])
  @@index([priority, status])
  @@index([assignedAdminId, status])
  @@index([lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id String @id @default(cuid())

  ticketId String

  senderType   SupportSenderType
  senderUserId String?

  content String

  clientMessageId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([senderUserId, clientMessageId])
  @@index([ticketId, createdAt])
  @@index([ticketId, isRead])
  @@index([senderUserId])
  @@map("support_messages")
}

model AssistantConversation {
  id String @id @default(cuid())

  customerId String

  status AssistantConversationStatus @default(ACTIVE)

  supportTicketId String? @unique

  startedAt     DateTime  @default(now())
  lastMessageAt DateTime?
  escalatedAt   DateTime?
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User           @relation("AssistantConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  supportTicket SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  messages AssistantMessage[]

  @@index([customerId, updatedAt])
  @@index([status, updatedAt])
  @@index([lastMessageAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id String @id @default(cuid())

  conversationId String

  senderType   AssistantSenderType
  senderUserId String?

  content String

  provider          String?
  providerMessageId String?
  model             String?

  clientMessageId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?                 @relation("AssistantMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([senderUserId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, isRead])
  @@index([senderUserId])
  @@map("assistant_messages")
}

model AppConfig {
  id              String  @id @default(cuid())
  key             String  @unique
  shareMessage    String
  androidStoreUrl String?
  iosStoreUrl     String?
  websiteUrl      String?

  aboutTitle       String?
  aboutDescription String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum FeedbackCategory {
  GENERAL
  APP_EXPERIENCE
  ASTROLOGY_CONTENT
  PAYMENT
  CONSULTATION
  TECHNICAL
  SUGGESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

model Feedback {
  id         String           @id @default(cuid())
  customerId String
  category   FeedbackCategory
  rating     Int?
  message    String
  status     FeedbackStatus   @default(NEW)

  adminNote String?

  reviewedAt DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([category, createdAt])
  @@map("feedback")
}
