// Additive marketplace review cases. Approval never implies a provider refund.
model MarketplaceOrderCase {
  refundAttempt MarketplaceRefundAttempt?
  id String @id @default(uuid())
  orderId String
  customerUserId String
  kind String
  status String @default("REQUESTED")
  amountMinor Int?
  currency String
  reason String
  idempotencyKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  events MarketplaceCaseEvent[]
  @@unique([customerUserId, idempotencyKey])
  @@index([orderId, status])
}

// Default-off provider-workflow foundation, not a financial refund approval.
model MarketplaceRefundAttempt {
  id String @id
  caseId String @unique
  providerPaymentId String
  amountMinor BigInt
  currency String
  policyRevision String
  componentSnapshot Json
  state String @default("PREPARED")
  leaseToken String?
  leaseUntil DateTime? @db.Timestamp(3)
  providerRefundId String? @unique
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  case MarketplaceOrderCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  events MarketplaceRefundAttemptEvent[]
  @@index([state, leaseUntil])
}

model MarketplaceRefundAttemptEvent {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  attemptId String
  state String
  createdAt DateTime @default(now()) @db.Timestamp(3)
  attempt MarketplaceRefundAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@index([attemptId, createdAt])
}

model MarketplaceCaseEvent {
  id String @id @default(uuid())
  caseId String
  actorUserId String
  action String
  createdAt DateTime @default(now())
  case MarketplaceOrderCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([caseId, createdAt])
}

// Append-only component journal; old orders are never silently backfilled.
model MarketplaceFinancialEntry {
  id String @id @default(uuid())
  sellerOrderId String
  eventKey String @unique
  kind String
  currency String
  productMinor BigInt
  discountMinor BigInt
  shippingMinor BigInt
  taxMinor BigInt
  feeMinor BigInt
  sellerMinor BigInt
  platformMinor BigInt
  createdAt DateTime @default(now())
  sellerOrder MarketplaceSellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  @@index([sellerOrderId, createdAt])
}

// Prepared additive moderation schema. Rollout remains default-off.
model AdminModerationSubject {
  kind String
  userId String
  state String
  version Int @default(0)
  requestedFields String[] @default([])
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  history AdminModerationAudit[]
  @@id([kind, userId])
}
model AdminModerationAudit {
  requestId String @id
  actorId String
  userId String
  kind String
  action String
  reason String
  details Json?
  previousState String
  nextState String
  version Int
  createdAt DateTime @default(now()) @db.Timestamp(3)
  actor User @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  subject AdminModerationSubject @relation(fields: [kind, userId], references: [kind, userId], onDelete: Restrict)
  @@unique([kind, userId, version])
  @@index([kind, userId, createdAt])
}
