  paymentFxRate          Decimal?  @db.Decimal(18, 8)
  paymentFxQuotedAt      DateTime?
  razorpayAmountSubunits Decimal?  @db.Decimal(20, 0)

  subtotal      Decimal @db.Decimal(12, 2)
  shippingTotal Decimal @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)

  razorpayOrderId       String?   @unique
  razorpayPaymentId     String?   @unique
  razorpaySignature     String?
  paymentVerifiedAt     DateTime?
  paymentWebhookEventId String?   @unique

  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String
  country      String
  countryCode  String?

  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer User? @relation("MarketplaceCustomerOrders", fields: [customerUserId], references: [id], onDelete: SetNull)

  sellerOrders      MarketplaceSellerOrder[]
  paymentExceptions MarketplacePaymentException[]

  @@unique([customerUserId, prepareIdempotencyKey])
  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
}

model MarketplaceSellerOrder {
  id           String                       @id @default(cuid())
  orderId      String
  astrologerId String?
  status       MarketplaceFulfillmentStatus @default(PENDING)

  sellerDisplayName String?

  currency      String  @default("INR")
  subtotal      Decimal @db.Decimal(12, 2)
  shippingTotal Decimal @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)

  trackingCarrier String?
  trackingNumber  String?

  acceptedAt  DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  astrologer Astrologer? @relation("MarketplaceSellerOrders", fields: [astrologerId], references: [id], onDelete: SetNull)

  items   MarketplaceOrderItem[]
  earning MarketplaceSellerEarning?

  @@index([orderId])
  @@index([astrologerId, status])
  @@index([status, createdAt])
}

model MarketplaceOrderItem {
  id            String  @id @default(cuid())
  sellerOrderId String
  productId     String?

  productName String
  productSku  String
  currency    String @default("INR")

  mrp            Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  quantity       Int
  shippingCharge Decimal @db.Decimal(12, 2)
  lineSubtotal   Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  sellerOrder MarketplaceSellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  product MarketplaceProduct? @relation("MarketplaceOrderItems", fields: [productId], references: [id], onDelete: SetNull)

  @@index([sellerOrderId])
  @@index([productId])
}

model MarketplaceSellerEarning {
  id            String  @id @default(cuid())
  sellerOrderId String  @unique
  astrologerId  String
  payoutId      String?

  currency String @default("INR")

  grossAmount        Decimal @db.Decimal(12, 2)
  platformFeePercent Decimal @db.Decimal(5, 2)
  platformFeeAmount  Decimal @db.Decimal(12, 2)
  netAmount          Decimal @db.Decimal(12, 2)

  status      MarketplaceEarningStatus @default(PENDING)
  availableAt DateTime?
  paidAt      DateTime?
  reversedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  sellerOrder MarketplaceSellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  astrologer Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  payout MarketplaceSellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([astrologerId, status])
  @@index([payoutId])
  @@index([createdAt])
}

model MarketplaceSellerPayout {
  id           String                  @id @default(cuid())
  astrologerId String
  amount       Decimal                 @db.Decimal(12, 2)
  currency     String                  @default("INR")
  status       MarketplacePayoutStatus @default(REQUESTED)

  providerReference String?
  idempotencyKey    String? @unique
  failureReason     String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  astrologer Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  earnings MarketplaceSellerEarning[]

  @@index([astrologerId, status])
  @@index([createdAt])
}

model MarketplacePaymentException {
  id                  String                            @id @default(uuid())
  marketplaceOrderId  String
  razorpayOrderId     String
  razorpayPaymentId   String                            @unique
  amount              Int
  currency            String                            @default("INR")
  reason              String
  status              MarketplacePaymentExceptionStatus @default(REFUND_REQUIRED)
  razorpayRefundId    String?                           @unique
  refundFailureReason String?
  refundRequestedAt   DateTime?
  refundedAt          DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  marketplaceOrder    MarketplaceOrder                  @relation(fields: [marketplaceOrderId], references: [id], onDelete: Restrict)

  @@index([marketplaceOrderId])
  @@index([status])
  @@index([createdAt])
  @@map("marketplace_payment_exceptions")
}

model AppLanguage {
  id          String   @id @default(cuid())
  code        String   @unique
  englishName String
  nativeName  String
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("app_languages")
}

model AppTranslation {
  id           String   @id @default(cuid())
  languageCode String
  key          String
  value        String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([languageCode, key])
  @@index([languageCode, isActive])
  @@map("app_translations")
}

// ============================================================
// AI CONSULTANT TYPE MASTER
// Backend-authoritative catalog for AI consultation specialties.
// Do not hardcode consultant catalog in mobile/web clients.
// ============================================================
model AiConsultantType {
  code           String   @id
  name           String
  description    String
  iconKey        String?
  sortOrder      Int      @default(0)
  isEnabled      Boolean  @default(true)
  requiresKundli Boolean  @default(false)
  safetyProfile  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isEnabled])
  @@index([sortOrder])
  @@map("ai_consultant_types")
}

model AiAstroSession {
  id              String @id @default(cuid())
  clientSessionId String @unique

  userId             String
  astrologerId       String?
  consultantTypeCode String

  pricingMode   String  @default("PER_MINUTE")
  ratePerMinute Decimal @db.Decimal(12, 2)
  currency      String  @default("INR")

  reservedAmount Decimal @default(0) @db.Decimal(12, 2)
  chargedAmount  Decimal @default(0) @db.Decimal(12, 2)

  // Customer-selected AI consultation duration.
  // Flutter will send values such as 5, 10, 15 or 20 minutes.
  durationMinutes Int @default(1)

  status String @default("ACTIVE")

  startedAt       DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  endedAt         DateTime?

  billableSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([astrologerId, status])
  @@index([lastHeartbeatAt])
  @@map("ai_astro_sessions")
}

model RechargePack {
  id           String   @id @default(cuid())
  amount       Decimal  @db.Decimal(12, 2)
  bonusPercent Decimal  @default(0) @db.Decimal(5, 2)
  bonusAmount  Decimal  @default(0) @db.Decimal(12, 2)
  label        String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("recharge_packs")
}

enum AstrologerKundliReportStatus {
  DRAFT
  FINAL
}

model AstrologerKundliReport {
  id             String @id @default(cuid())
  callSessionId  String @unique
  customerUserId String
  astrologerId   String

  status AstrologerKundliReportStatus @default(DRAFT)

  title     String?
  summary   String? @db.Text
  character String? @db.Text
  career    String? @db.Text
  marriage  String? @db.Text
  finance   String? @db.Text
  health    String? @db.Text
  remedies  String? @db.Text
  notes     String? @db.Text

  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  customer    User        @relation("AstrologerKundliReportCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  astrologer  User        @relation("AstrologerKundliReportAstrologer", fields: [astrologerId], references: [id], onDelete: Cascade)

  attachments AstrologerKundliReportAttachment[]

  @@index([customerUserId, status, createdAt])
  @@index([astrologerId, status, createdAt])
  @@map("astrologer_kundli_reports")
}

model AstrologerKundliReportAttachment {
  id       String @id @default(cuid())
  reportId String

  storageUrl  String
  storagePath String?

  fileName  String
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  report AstrologerKundliReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("astrologer_kundli_report_attachments")
}

model AstrologyQuestionAnswerCache {
  id                String   @id @default(cuid())
  userId            String
  questionId        String
  kundliHash        String
  language          String   @default("en")
  model             String
  promptVersion     String   @default("v1")
  questionUpdatedAt DateTime
  answer            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question AstrologyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, kundliHash, language, model, promptVersion, questionUpdatedAt])
  @@index([userId, createdAt])
  @@index([questionId])
  @@map("astrology_question_answer_cache")
}
