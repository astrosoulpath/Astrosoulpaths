  SELLER_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_DISABLED
  PRODUCT_FEATURED
  PRODUCT_UNFEATURED
  CATEGORY_CREATED
  CATEGORY_UPDATED
