// Additive smart notification contract; deployment requires separate reviewed DDL.
model SmartNotificationPolicy {
  category String @id
  enabled Boolean @default(false)
  languages String[] @default([])
  controlVersion Int @default(1)
  scheduleMinute Int @default(540)
  approved Boolean @default(false)
  entitlement String @default("UNAPPROVED")
  revision Int @default(1)
  dailyLimit Int @default(1)
  minimumIntervalMs Int @default(86400000)
  quietStart Int @default(1320)
  quietEnd Int @default(480)
  consents SmartNotificationConsent[]
  campaigns SmartNotificationCampaign[]
  insights SmartNotificationInsight[]
}
model SmartNotificationConsent {
  userId String
  category String
  version Int @default(1)
  granted Boolean @default(false)
  birthUse Boolean @default(false)
  engagementGranted Boolean @default(false)
  expiresAt DateTime @db.Timestamptz(6)
  timezone String
  user User @relation(fields:[userId], references:[id], onDelete:Restrict, onUpdate:NoAction)
  policy SmartNotificationPolicy @relation(fields:[category], references:[category], onDelete:Restrict, onUpdate:NoAction)
  @@id([userId,category])
}
model SmartNotificationCampaign {
  id String @id
  category String
  locale String
  title String
  body String
  provenance String @default("ADMIN_EDITORIAL")
  revision Int @default(1)
  state String @default("DRAFT")
  createdBy String
  approvedBy String?
  scheduledAt DateTime? @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  creator User @relation("SmartCampaignCreator",fields:[createdBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  approver User? @relation("SmartCampaignApprover",fields:[approvedBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  policy SmartNotificationPolicy @relation(fields:[category],references:[category],onDelete:Restrict,onUpdate:NoAction)
  insights SmartNotificationInsight[]
}
model SmartNotificationInsight {
  id String @id
  userId String
  category String
  locale String
  title String
  body String
  provenance String
  factors Json @default("[]")
  sourceVersion String
  generationKey String? @unique
  consentVersion Int
  policyRevision Int
  campaignId String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  policy SmartNotificationPolicy @relation(fields:[category],references:[category],onDelete:Restrict,onUpdate:NoAction)
  campaign SmartNotificationCampaign? @relation(fields:[campaignId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  delivery SmartNotificationDelivery[]
  opens SmartNotificationOpen[]
  @@unique([userId,campaignId])
  @@unique([id,userId])
  @@index([userId,createdAt],map:"SmartNotificationInsight_owner_idx")
}
model SmartNotificationDelivery {
  id String @id
  insightId String @unique
  userId String
  state String @default("QUEUED")
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime? @db.Timestamptz(6)
