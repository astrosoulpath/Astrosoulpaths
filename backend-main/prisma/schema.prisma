// SELLER
// Astrologer requests access.
// Only ADMIN can make status ACTIVE.
// ============================================================

model MarketplaceSellerProfile {
  id               String                  @id @default(cuid())
  astrologerId     String                  @unique
  status           MarketplaceSellerStatus @default(PENDING)
  shopDisplayName  String?
  shopBio          String?
