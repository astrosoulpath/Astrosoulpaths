  updatedAt   DateTime @updatedAt

  products MarketplaceProduct[]

  @@index([isActive, sortOrder])
}

// ============================================================
// PRODUCT
//
// Seller may CREATE/EDIT DRAFT.
// Seller submits -> PENDING_REVIEW.
// ADMIN approves -> ACTIVE.
//
// Customer visibility later:
// seller ACTIVE
// product ACTIVE
// stock > 0
// ============================================================

model MarketplaceProduct {
  id                String                   @id @default(cuid())
  astrologerId      String
  categoryId        String
  name              String
  slug              String                   @unique
  sku               String                   @unique
  shortDescription  String?
  description       String?
  currency          String                   @default("INR")
  mrp               Decimal                  @db.Decimal(12, 2)
  sellingPrice      Decimal                  @db.Decimal(12, 2)
  stock             Int                      @default(0)
  lowStockThreshold Int                      @default(5)
  shippingCharge    Decimal                  @default(0) @db.Decimal(12, 2)
  weightGrams       Int?
  status            MarketplaceProductStatus @default(DRAFT)
  isFeatured        Boolean                  @default(false)
  rejectionReason   String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  astrologer Astrologer          @relation(fields: [astrologerId], references: [id])
  category   MarketplaceCategory @relation(fields: [categoryId], references: [id])

  images           MarketplaceProductImage[]
  campaignProducts MarketplaceCampaignProduct[]

  cartItems             MarketplaceCartItem[]
  marketplaceOrderItems MarketplaceOrderItem[] @relation("MarketplaceOrderItems")

  @@index([astrologerId])
  @@index([categoryId])
  @@index([status])
  @@index([status, stock])
  @@index([isFeatured, status])
}

// ============================================================
// REAL PRODUCT IMAGES
// Only actual uploaded URLs will create records.
// ============================================================

model MarketplaceProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

