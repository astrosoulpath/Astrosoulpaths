  feedbackId String @id
  consultationId String
  feedback Feedback @relation(fields:[feedbackId],references:[id],onDelete:Restrict)
  consultation CallSession @relation(fields:[consultationId],references:[id],onDelete:Restrict)
  @@index([consultationId])
}
model FeedbackEscalation {
  feedbackId String @id
  ticketId String @unique
  feedback Feedback @relation(fields:[feedbackId],references:[id],onDelete:Restrict)
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
}

model SupportAttachment {
  id String @id @default(cuid())

  ticketId String

  storageBucket String
  storagePath   String @unique

  originalFileName String
  contentType      String
  sizeBytes        Int

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_attachments")
}

model SupportMessage {
  id String @id @default(cuid())

  ticketId String

  senderType   SupportSenderType
  senderUserId String?

  content String

  clientMessageId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([senderUserId, clientMessageId])
  @@index([ticketId, createdAt])
  @@index([ticketId, isRead])
  @@index([senderUserId])
  @@map("support_messages")
}

model AssistantConversation {
  id String @id @default(cuid())

  customerId String

  status AssistantConversationStatus @default(ACTIVE)

  supportTicketId String? @unique

  startedAt     DateTime  @default(now())
  lastMessageAt DateTime?
  escalatedAt   DateTime?
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User           @relation("AssistantConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  supportTicket SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  messages AssistantMessage[]

  @@index([customerId, updatedAt])
  @@index([status, updatedAt])
  @@index([lastMessageAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id String @id @default(cuid())

  conversationId String

  senderType   AssistantSenderType
  senderUserId String?

  content String

  provider          String?
  providerMessageId String?
  model             String?

  clientMessageId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?                 @relation("AssistantMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([senderUserId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, isRead])
  @@index([senderUserId])
  @@map("assistant_messages")
}

model AppConfig {
  id              String  @id @default(cuid())
  key             String  @unique
  shareMessage    String
  androidStoreUrl String?
  iosStoreUrl     String?
  websiteUrl      String?

  aboutTitle       String?
  aboutDescription String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum FeedbackCategory {
  GENERAL
  APP_EXPERIENCE
  ASTROLOGY_CONTENT
  PAYMENT
  CONSULTATION
  TECHNICAL
  SUGGESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

model Feedback {
  context FeedbackContext?
  escalation FeedbackEscalation?
  id         String           @id @default(cuid())
  customerId String
  category   FeedbackCategory
  rating     Int?
  message    String
  status     FeedbackStatus   @default(NEW)

  adminNote String?

  reviewedAt DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([category, createdAt])
  @@map("feedback")
}

// ============================================================
// SOUL BAZAAR MARKETPLACE
// Production only.
// No dummy products.
// No fake categories.
// No demo campaigns.
// Admin controls public marketplace state.
// ============================================================

enum MarketplaceSellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MarketplaceProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  OUT_OF_STOCK
  ARCHIVED
}

enum MarketplaceCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum MarketplaceDiscountType {
  PERCENTAGE
  FLAT
}

enum MarketplaceAdminActionType {
  SELLER_ACTIVATED
  SELLER_SUSPENDED
  SELLER_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_DISABLED
  PRODUCT_FEATURED
  PRODUCT_UNFEATURED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DISABLED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_ACTIVATED
  CAMPAIGN_PAUSED
  CAMPAIGN_CANCELLED
}

// ============================================================
// SELLER
// Astrologer requests access.
// Only ADMIN can make status ACTIVE.
// ============================================================

model MarketplaceSellerProfile {
  id               String                  @id @default(cuid())
  astrologerId     String                  @unique
  status           MarketplaceSellerStatus @default(PENDING)
  shopDisplayName  String?
  shopBio          String?
  suspensionReason String?
  rejectionReason  String?
  activatedAt      DateTime?
  suspendedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  astrologer Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ============================================================
// CATEGORY
// Admin created and managed.
// ============================================================

model MarketplaceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products MarketplaceProduct[]

  @@index([isActive, sortOrder])
}

// ============================================================
// PRODUCT
//
// Seller may CREATE/EDIT DRAFT.
// Seller submits -> PENDING_REVIEW.
// ADMIN approves -> ACTIVE.
//
// Customer visibility later:
// seller ACTIVE
// product ACTIVE
// stock > 0
// ============================================================

model MarketplaceProduct {
  id                String                   @id @default(cuid())
  astrologerId      String
  categoryId        String
  name              String
  slug              String                   @unique
  sku               String                   @unique
  shortDescription  String?
  description       String?
  currency          String                   @default("INR")
  mrp               Decimal                  @db.Decimal(12, 2)
  sellingPrice      Decimal                  @db.Decimal(12, 2)
  stock             Int                      @default(0)
  lowStockThreshold Int                      @default(5)
  shippingCharge    Decimal                  @default(0) @db.Decimal(12, 2)
  weightGrams       Int?
  status            MarketplaceProductStatus @default(DRAFT)
  isFeatured        Boolean                  @default(false)
  rejectionReason   String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  astrologer Astrologer          @relation(fields: [astrologerId], references: [id])
  category   MarketplaceCategory @relation(fields: [categoryId], references: [id])

  images           MarketplaceProductImage[]
  campaignProducts MarketplaceCampaignProduct[]

  cartItems             MarketplaceCartItem[]
  marketplaceOrderItems MarketplaceOrderItem[] @relation("MarketplaceOrderItems")

  @@index([astrologerId])
  @@index([categoryId])
  @@index([status])
  @@index([status, stock])
  @@index([isFeatured, status])
}

// ============================================================
// REAL PRODUCT IMAGES
// Only actual uploaded URLs will create records.
// ============================================================

model MarketplaceProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ============================================================
// FESTIVAL / SEASON CAMPAIGN
//
// Sawan / Shivratri / Navratri / Durga Puja /
// Diwali / Chhath Puja etc. are NOT seeded.
//
// Admin creates actual campaigns.
// Future festivals require no schema update.
// ============================================================

model MarketplaceCampaign {
  id             String                    @id @default(cuid())
  name           String
  slug           String                    @unique
  festivalKey    String?
  title          String
  subtitle       String?
  description    String?
  bannerImageUrl String?
  discountType   MarketplaceDiscountType
  discountValue  Decimal                   @db.Decimal(12, 2)
  maxDiscount    Decimal?                  @db.Decimal(12, 2)
  startAt        DateTime
  endAt          DateTime
  status         MarketplaceCampaignStatus @default(DRAFT)
  isActive       Boolean                   @default(true)
  priority       Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  products MarketplaceCampaignProduct[]

  @@index([status, isActive])
  @@index([startAt, endAt])
  @@index([priority])
}

// ============================================================
// PRODUCTS INCLUDED IN FESTIVAL SALE
// Selected by Admin.
// ============================================================

model MarketplaceCampaignProduct {
  id                    String                   @id @default(cuid())
  campaignId            String
  productId             String
  overrideDiscountType  MarketplaceDiscountType?
  overrideDiscountValue Decimal?                 @db.Decimal(12, 2)
  overrideMaxDiscount   Decimal?                 @db.Decimal(12, 2)
  createdAt             DateTime                 @default(now())

  campaign MarketplaceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  MarketplaceProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
}

// ============================================================
// ADMIN AUDIT TRAIL
// Important marketplace actions are attributable to admin.
// ============================================================

// ============================================================
// MARKETPLACE CUSTOMER CART
// Server-owned cart. Product price is NEVER stored as authority here.
// Checkout will recalculate price/stock from MarketplaceProduct.
// ============================================================

model MarketplaceCart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MarketplaceCartItem[]

  @@index([updatedAt])
}

model MarketplaceCartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    MarketplaceCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

// ============================================================
// MARKETPLACE DELIVERY ADDRESS
// Customer-owned physical delivery address.
// No payment/card information is stored here.
// ============================================================

model MarketplaceAddress {
  id           String   @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String
  country      String
  countryCode  String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model MarketplaceAdminAction {
  id          String                     @id @default(cuid())
  adminUserId String
  action      MarketplaceAdminActionType
  targetType  String
  targetId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime                   @default(now())

  admin User @relation("MarketplaceAdminActor", fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

//
// MARKETPLACE PHYSICAL ORDER / FULFILLMENT
// Payment integration intentionally remains separate.
//

enum MarketplacePaymentExceptionStatus {
  REFUND_REQUIRED
  REFUND_PROCESSING
  REFUNDED
  REFUND_FAILED
}

enum MarketplaceOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum MarketplaceFulfillmentStatus {
  PENDING
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MarketplaceEarningStatus {
  PENDING
  AVAILABLE
  PAYOUT_REQUESTED
  PAID
  REVERSED
}

enum MarketplacePayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model MarketplaceOrder {
  id                    String                 @id @default(cuid())
  orderNumber           String                 @unique
  customerUserId        String?
  prepareIdempotencyKey String?
  status                MarketplaceOrderStatus @default(PENDING_PAYMENT)
  currency              String                 @default("INR")

  // Payment presentation / gateway snapshot.
  // Existing currency/grandTotal remain the base marketplace order values.
  paymentCountryCode     String?
  paymentCurrency        String?
  paymentAmount          Decimal?  @db.Decimal(18, 6)
  paymentFxRate          Decimal?  @db.Decimal(18, 8)
  paymentFxQuotedAt      DateTime?
  razorpayAmountSubunits Decimal?  @db.Decimal(20, 0)

  subtotal      Decimal @db.Decimal(12, 2)
  shippingTotal Decimal @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)

  razorpayOrderId       String?   @unique
  razorpayPaymentId     String?   @unique
  razorpaySignature     String?
  paymentVerifiedAt     DateTime?
  paymentWebhookEventId String?   @unique

  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String
  country      String
  countryCode  String?

  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer User? @relation("MarketplaceCustomerOrders", fields: [customerUserId], references: [id], onDelete: SetNull)

  sellerOrders      MarketplaceSellerOrder[]
  paymentExceptions MarketplacePaymentException[]
  cases             MarketplaceOrderCase[]
  checkoutSnapshot MarketplaceCheckoutSnapshot?

  @@unique([customerUserId, prepareIdempotencyKey])
  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
}

model MarketplaceCheckoutSnapshot {
  paymentCommand MarketplacePaymentCommand?
  orderId String @id
  customerUserId String
  currency String
  amountMinor BigInt
  expiresAt DateTime @db.Timestamp(3)
  payload Json
  sha256 String
  createdAt DateTime @default(now()) @db.Timestamp(3)
  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
}

model MarketplacePaymentCommand {
  orderId String @id
  state String @default("CREATING")
  providerOrderId String? @unique
  createdAt DateTime @default(now()) @db.Timestamp(3)
  snapshot MarketplaceCheckoutSnapshot @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
}

model MarketplaceSellerOrder {
  id           String                       @id @default(cuid())
  orderId      String
  astrologerId String?
  status       MarketplaceFulfillmentStatus @default(PENDING)

  sellerDisplayName String?

  currency      String  @default("INR")
  subtotal      Decimal @db.Decimal(12, 2)
  shippingTotal Decimal @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)

  trackingCarrier String?
  trackingNumber  String?

  acceptedAt  DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  astrologer Astrologer? @relation("MarketplaceSellerOrders", fields: [astrologerId], references: [id], onDelete: SetNull)

  items   MarketplaceOrderItem[]
  earning MarketplaceSellerEarning?
  financialEntries MarketplaceFinancialEntry[]

  @@index([orderId])
  @@index([astrologerId, status])
  @@index([status, createdAt])
}

model MarketplaceOrderItem {
  id            String  @id @default(cuid())
  sellerOrderId String
  productId     String?

  productName String
  productSku  String
  currency    String @default("INR")

  mrp            Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  quantity       Int
  shippingCharge Decimal @db.Decimal(12, 2)
  lineSubtotal   Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  sellerOrder MarketplaceSellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  product MarketplaceProduct? @relation("MarketplaceOrderItems", fields: [productId], references: [id], onDelete: SetNull)

  @@index([sellerOrderId])
  @@index([productId])
}

model MarketplaceSellerEarning {
  id            String  @id @default(cuid())
  sellerOrderId String  @unique
  astrologerId  String
  payoutId      String?

  currency String @default("INR")

  grossAmount        Decimal @db.Decimal(12, 2)
  platformFeePercent Decimal @db.Decimal(5, 2)
  platformFeeAmount  Decimal @db.Decimal(12, 2)
  netAmount          Decimal @db.Decimal(12, 2)

  status      MarketplaceEarningStatus @default(PENDING)
  availableAt DateTime?
  paidAt      DateTime?
  reversedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  sellerOrder MarketplaceSellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  astrologer Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  payout MarketplaceSellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([astrologerId, status])
  @@index([payoutId])
  @@index([createdAt])
}

model MarketplaceSellerPayout {
  id           String                  @id @default(cuid())
  astrologerId String
  amount       Decimal                 @db.Decimal(12, 2)
  currency     String                  @default("INR")
  status       MarketplacePayoutStatus @default(REQUESTED)

  providerReference String?
  idempotencyKey    String? @unique
  failureReason     String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  astrologer Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  earnings MarketplaceSellerEarning[]

  @@index([astrologerId, status])
  @@index([createdAt])
}

model MarketplacePaymentException {
  id                  String                            @id @default(uuid())
  marketplaceOrderId  String
  razorpayOrderId     String
  razorpayPaymentId   String                            @unique
  amount              Int
  currency            String                            @default("INR")
  reason              String
  status              MarketplacePaymentExceptionStatus @default(REFUND_REQUIRED)
  razorpayRefundId    String?                           @unique
  refundFailureReason String?
  refundRequestedAt   DateTime?
  refundedAt          DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  marketplaceOrder    MarketplaceOrder                  @relation(fields: [marketplaceOrderId], references: [id], onDelete: Restrict)

  @@index([marketplaceOrderId])
  @@index([status])
  @@index([createdAt])
  @@map("marketplace_payment_exceptions")
}

model AppLanguage {
  id          String   @id @default(cuid())
  code        String   @unique
  englishName String
  nativeName  String
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("app_languages")
}

model AppTranslation {
  id           String   @id @default(cuid())
  languageCode String
  key          String
  value        String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([languageCode, key])
  @@index([languageCode, isActive])
  @@map("app_translations")
}

// ============================================================
// AI CONSULTANT TYPE MASTER
// Backend-authoritative catalog for AI consultation specialties.
// Do not hardcode consultant catalog in mobile/web clients.
