  createdAt DateTime @default(now()) @db.Timestamptz(6)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  attemptedAt DateTime? @db.Timestamptz(6)
  insight SmartNotificationInsight @relation(fields:[insightId,userId],references:[id,userId],onDelete:Restrict,onUpdate:NoAction)
  @@index([state,createdAt],map:"SmartNotificationDelivery_claim_idx")
  @@index([state,nextAttemptAt,createdAt,id],map:"SmartNotificationDelivery_due_idx")
  @@index([userId,attemptedAt],map:"SmartNotificationDelivery_frequency_idx")
}
model SmartNotificationAudit {
