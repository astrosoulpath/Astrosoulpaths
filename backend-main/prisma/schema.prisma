// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Define your data models here. For example:
// User model:- 

model User {
  id String @id @default(uuid())

  // 🔐 Supabase Auth Mapping
  supabaseId String @unique

  // 📱 Contact Info
  phone     String? @unique
  email     String? @unique
  name      String?
  avatarUrl String?
  

  // Wallet & Payments
  wallet        Wallet?
  walletLedger  WalletLedger[]
  paymentOrders PaymentOrder[]
  kundliOrders  KundliOrder[]

  gender Gender?

  // 🧠 Role & Access
  roleId String @default("USER")
  role   Role   @relation(fields: [roleId], references: [id])

  // 🔀 Onboarding + Routing
  isNewUser         Boolean @default(true)
  isAstrologer      Boolean @default(false)
  isProfileComplete Boolean @default(false)

  // 🚦 Status Controls
  isActive   Boolean @default(true)
  isBlocked  Boolean @default(false)
  isVerified Boolean @default(false)

  // 💎 Subscription
  subscriptionStatus SubscriptionStatus @default(FREE)

  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  // 📊 Metadata
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 💳 Payment Mapping
  razorpayCustomerId String?

  // 🔗 Relations
  astrologer    Astrologer?
    userProfile   UserProfile?
  profiles      Profile[]      @relation("UserProfiles")
  reviews       Review[]
  subscriptions Subscription[]
  calls         CallSession[]  @relation("UserCalls")
  astrologerCalls CallSession[] @relation("AstrologerCalls")
  // payments       Payment[]

  @@index([phone])
  @@index([supabaseId])
  @@index([roleId])
  @@index([isAstrologer])
}

// Astrologer model:-

model Astrologer {
  id String @id @default(uuid())

  // 🔗 Relation with User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  profileUrl String? // Link to astrologer's profile page
  Gender     Gender?
  // 🧾 Basic Profile
  bio        String?
  languages  String[] // ["Hindi", "English"]
  expertise  AstrologerExpertise[] // ["Vedic", "Tarot", "Numerology"]

  experience Int? // years of experience

  // 💰 Pricing
  pricePerMin Float?

  // ⭐ Rating System
  rating       Float? // avg rating
  totalReviews Int    @default(0)

  // 📄 Verification & Approval
  isApproved Boolean @default(false)
  isVerified Boolean @default(false)

  // 📂 Documents (KYC)
  documents Json? // store URLs of uploaded docs

  // 🟢 Availability
  isOnline Boolean  @default(false)
  reviews  Review[]

  // 📊 Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔗 Relations
  //sessions    Session[]

  @@index([userId])
  @@index([isApproved])
  @@index([isVerified])
  @@index([isOnline])
  @@index([rating])
}

model Expertise {
  id   String @id @default(uuid())
  name String @unique // "Vedic Astrology", "Tarot", "Numerology"

  astrologers AstrologerExpertise[]
}

model AstrologerExpertise {
  id           String @id @default(uuid())
  astrologerId String
  expertiseId  String

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])
  expertise  Expertise  @relation(fields: [expertiseId], references: [id])

  @@unique([astrologerId, expertiseId])
}

model Review {
  id           String @id @default(uuid())
  astrologerId String
  userId       String

  rating  Int // 1–5
  comment String?

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

//Role Based Access Control (RBAC):-

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // ADMIN, USER, ASTROLOGER
  description String?

  // 🔗 Relations
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Permission {
  id String @id @default(uuid())

  name        String  @unique // CREATE_KUNDLI, DELETE_USER
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model Profile {
  id     String @id @default(uuid())
  userId String

  lang String @default("en")

  name   String
  gender Gender

  birthDate DateTime
  birthTime String

  // 🌍 Geo Data
  lat          Float
  lon          Float
  timezone     Float
  timezoneName String?

  city        String?
  state       String?
  country     String?
  countryCode String?

  fullname String?

  isDeleted Boolean @default(false)

  user User @relation("UserProfiles", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsBoy  Match[] @relation("Boy")
  matchesAsGirl Match[] @relation("Girl")

  @@index([userId])
}

model Match {
  id String @id @default(cuid())

  boyId  String
  girlId String

  boy  Profile @relation("Boy", fields: [boyId], references: [id])
  girl Profile @relation("Girl", fields: [girlId], references: [id])

  score  Int? // guna milan score
  result Json? // full compatibility result

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isSaved   Boolean  @default(false) // if user saved this match

  @@unique([boyId, girlId]) // prevent duplicate matches
}

model KundliData {
  id       String @id @default(cuid())
  kundliId String @unique

  lang String @default("en")

  vedic Json?

  currentMahaDasha Json?

  apiVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kundli Kundli @relation(fields: [kundliId], references: [id])

  @@unique([kundliId, lang])
}

model Kundli {
  id String @id @default(cuid())

  dob String // ✅ REQUIRED
  tob String // ✅ (rename from birthTime)

  latitude  Float
  longitude Float
  timezone  Float

  hash String @unique

  data KundliData?
  orders KundliOrder[]

  createdAt DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StorageType {
  CLOUD
  LOCAL
}

model Subscription {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  subscriptionStatus SubscriptionStatus @default(FREE)

  amount   Int?
  currency String @default("INR")

  razorpaySubscriptionId String? @unique
  razorpayCustomerId     String?
  razorpayPaymentId      String?
  razorpayOrderId        String?

  startDate     DateTime?
  endDate       DateTime?
  nextBillingAt DateTime?

  isTrial Boolean @default(false)

  cancelledAt DateTime?
  expiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionStatus])
  @@index([subscriptionPlanId])
}

model SubscriptionPlan {
  id String @id @default(uuid())

  name        String  @unique
  displayName String
  description String?

  price    Int
  currency String @default("INR")

  durationDays Int

  features Json?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  razorpayPlanId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  users         User[]
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  FAILED
  PAUSED
  FREE
  TRIAL
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
  PARTIAL
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  EXPIRED
}

enum LedgerType {
  RECHARGE
  CALL_DEDUCTION
  REFUND
  BONUS
  PENALTY
  WITHDRAWAL
  GIFT_SENT
  GIFT_RECEIVED
}

enum LedgerReferenceType {
  WALLET_RECHARGE
  CALL_SESSION
  GIFT
  KUNDLI_REPORT
  REFUND
}

enum PaymentType {
  WALLET_RECHARGE
  KUNDLI_REPORT
  SUBSCRIPTION
  GIFT_PURCHASE
}

enum KundliOrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Wallet {
  id String @id @default(cuid())

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Money
  balance       Decimal @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("INR")

  // Relations
  ledgerEntries WalletLedger[]
  paymentOrders PaymentOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model PaymentOrder {
  id String @id @default(cuid())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // Razorpay
  razorpayOrderId   String  @unique
  razorpayPaymentId String?
  razorpaySignature String?

  // Payment
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  paymentMethod String?
  type          PaymentType @default(WALLET_RECHARGE)
  metadata      Json?

  status PaymentStatus @default(PENDING)

  // Debugging / Auditing
  rawWebhook Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kundliOrder KundliOrder?

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([type])
  @@map("payment_orders")
}

model KundliOrder {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentOrderId String       @unique
  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  kundliId String?
  kundli   Kundli? @relation(fields: [kundliId], references: [id], onDelete: SetNull)

  status KundliOrderStatus @default(PENDING)

  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WalletLedger {
  id String @id @default(cuid())

  // Relations
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ledger Info
  type LedgerType

  amount Decimal @db.Decimal(12, 2)

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  // Reference Tracking
  referenceType LedgerReferenceType?
  referenceId   String?

  description String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@map("wallet_ledger")
}



model CallSession {
  id                String   @id @default(cuid())

  userId            String
  astrologerId      String

  channelName       String

  ratePerMinute     Float

  purchasedMinutes  Int
  extendedMinutes   Int      @default(0)

  amountCharged     Float

  startedAt         DateTime
  expiresAt         DateTime
  endedAt           DateTime?

  status            String

  createdAt         DateTime @default(now())

  user       User @relation("UserCalls", fields: [userId], references: [id])
  astrologer User @relation("AstrologerCalls", fields: [astrologerId], references: [id])
}

model UserProfile {
  id          String   @id @default(cuid())
  
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  username    String?   @unique
  email       String?   @unique
  phoneNumber String?   @unique
  dateOfBirth DateTime?
  timeOfBirth String?
  latitude    Float?
  longitude   Float?
  timezone    Float?
  city        String?
  state       String?
  country     String?
  countryCode String?
  timezoneName String?
  gender      Gender
  location    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}