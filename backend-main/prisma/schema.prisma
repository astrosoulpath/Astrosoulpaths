generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConsultationBirthSharing {
  profileRef String
  revision Int @default(1)
  consultationId String @id
  customerId String
  astrologerId String
  birthVersion String
  policyVersion String
  expiresAt DateTime @db.Timestamp(3)
  revokedAt DateTime? @db.Timestamp(3)
  consultation CallSession @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer User @relation("BirthSharingCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  astrologer User @relation("BirthSharingAstrologer", fields: [astrologerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model ConsultationBirthSharingAudit {
  profileRef String
  birthVersion String
  revision Int
  id String @id
  consultationId String
  actorId String
  action String
  policyVersion String
  createdAt DateTime @default(now()) @db.Timestamp(3)
  consultation CallSession @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([consultationId, createdAt])
}

model User {
  subscriptionReminderPreferences SubscriptionReminderPreference[]
  moderationSubjects AdminModerationSubject[]
  moderationActions AdminModerationAudit[] @relation("ModerationActor")
  supportOperationAudits SupportOperationAudit[]
  supportPrivateNotes SupportPrivateNote[]
  supportDeliveries SupportDelivery[]
  birthSharingAsCustomer ConsultationBirthSharing[] @relation("BirthSharingCustomer")
  birthSharingAsAstrologer ConsultationBirthSharing[] @relation("BirthSharingAstrologer")
  birthSharingAudits ConsultationBirthSharingAudit[]
  smartNotificationConsents SmartNotificationConsent[]
  smartNotificationInsights SmartNotificationInsight[]
  smartCampaignsCreated SmartNotificationCampaign[] @relation("SmartCampaignCreator")
  smartCampaignsApproved SmartNotificationCampaign[] @relation("SmartCampaignApprover")
  smartNotificationAudits SmartNotificationAudit[]
  kundliConsentsAsCustomer   KundliGenerationConsent[]        @relation("KundliConsentCustomer")
  kundliConsentsAsAstrologer KundliGenerationConsent[]        @relation("KundliConsentAstrologer")
  kundliConsentsGranted      KundliGenerationConsent[]        @relation("KundliConsentGrantor")
  kundliConsentAudits        KundliGenerationConsentAudit[]
  kundliGenerationRequests   KundliGenerationRequest[]
  horoscopeReadings          PersonalizedHoroscopeReading[]
  horoscopeOutbox            HoroscopeNotificationOutbox[]
  horoscopePreference        HoroscopeNotificationPreference?
  astrologerFollows          AstrologerFollow[]               @relation("UserAstrologerFollows")
  aiAstroFollows             AiAstroFollow[]                  @relation("UserAiAstroFollows")
  id                         String                           @id @default(uuid())
  supabaseId                 String                           @unique
  phone                      String?                          @unique
  email                      String?                          @unique
  name                       String?
  avatarUrl                  String?
  gender                     Gender?
  roleId                     String
  isActive                   Boolean                          @default(true)
  isBlocked                  Boolean                          @default(false)
  isVerified                 Boolean                          @default(false)
  lastLoginAt                DateTime?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  isAstrologer               Boolean                          @default(false)
  isNewUser                  Boolean                          @default(true)
  freeChatGrantedAt          DateTime?
  freeChatUsedAt             DateTime?
  freeChatMinutes            Int                              @default(1)
  isProfileComplete          Boolean                          @default(false)
  razorpayCustomerId         String?
  subscriptionPlanId         String?
  subscriptionStatus         SubscriptionStatus               @default(FREE)
  astrologer                 Astrologer?
  astrologerCalls            CallSession[]                    @relation("AstrologerCalls")
  calls                      CallSession[]                    @relation("UserCalls")
  kundliOrders               KundliOrder[]
  savedKundlis               KundliSavedRecord[]
  profiles                   Profile[]                        @relation("UserProfiles")
  reviews                    Review[]
  blocksCreated              UserBlock[]                      @relation("UserBlocksCreated")
  blocksReceived             UserBlock[]                      @relation("UserBlocksReceived")
  reportsCreated             UserReport[]                     @relation("UserReportsCreated")
  reportsReceived            UserReport[]                     @relation("UserReportsReceived")
  subscriptions              Subscription[]
  dailyHoroscopeHistory      DailyHoroscopeHistory[]
  astrologyAnswerCaches      AstrologyQuestionAnswerCache[]
  role                       Role                             @relation(fields: [roleId], references: [id])
  subscriptionPlan           SubscriptionPlan?                @relation(fields: [subscriptionPlanId], references: [id])
  userProfile                UserProfile?
  sentChatMessages           ChatMessage[]                    @relation("ChatMessageSender")
  paymentOrders              PaymentOrder[]
  paymentCreationCommands    PaymentCreationCommand[]
  financeActions             AdminFinanceAction[]
  walletLedger               WalletLedger[]
  wallet                     Wallet?
  pushDevices                PushDevice[]
  qualificationAttempts      AstrologerQualificationAttempt[]
  e2eeDevices                ChatEncryptionDevice[]
  liveViews                  LiveViewer[]
  liveMessages               LiveMessage[]
  liveConnections            LiveConnection[]
  aiAstroUsages              AiAstroUsage[]
  aiAstroConversations       AiAstroConversation[]
  appNotifications           AppNotification[]
  marketplaceAdminActions    MarketplaceAdminAction[]         @relation("MarketplaceAdminActor")
  UserPreference             UserPreference?

  // 24x7 Support System
  authIdentities         UserAuthIdentity[]
  supportTickets         SupportTicket[]         @relation("SupportTicketCustomer")
  assignedSupportTickets SupportTicket[]         @relation("SupportTicketAssignedAdmin")
  supportMessages        SupportMessage[]        @relation("SupportMessageSender")
  assistantConversations AssistantConversation[] @relation("AssistantConversationCustomer")
  assistantMessages      AssistantMessage[]      @relation("AssistantMessageSender")
  Feedback               Feedback[]

  marketplaceCart       MarketplaceCart?
  marketplaceAddresses  MarketplaceAddress[]
  marketplaceOrders     MarketplaceOrder[]       @relation("MarketplaceCustomerOrders")
  marketplaceCheckoutSnapshots MarketplaceCheckoutSnapshot[]
  marketplaceCases      MarketplaceOrderCase[]
  marketplaceCaseEvents MarketplaceCaseEvent[]
  customerKundliReports AstrologerKundliReport[] @relation("AstrologerKundliReportCustomer")
  authoredKundliReports AstrologerKundliReport[] @relation("AstrologerKundliReportAstrologer")

  @@index([phone])
  @@index([supabaseId])
  @@index([roleId])
  @@index([isAstrologer])
}

model UserAuthIdentity {
  id String @id @default(cuid())

  userId String

  provider       String @default("supabase")
  providerUserId String
  identityType   String

  email String?
  phone String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
  @@index([phone])
  @@map("user_auth_identities")
}

model Astrologer {
  followers                AstrologerFollow[]         @relation("AstrologerFollowers")
  availabilities           AstrologerAvailability[]
  id                       String                     @id @default(uuid())
  userId                   String                     @unique
  profileUrl               String?
  aiAvatarUrl              String?
  Gender                   Gender?
  bio                      String?
  languages                String[]
  consultationCategories   String[]                   @default([])
  experience               Int?
  pricePerMin              Float?
  rating                   Float?
  totalReviews             Int                        @default(0)
  isApproved               Boolean                    @default(false)
  isVerified               Boolean                    @default(false)
  documents                Json?
  isOnline                 Boolean                    @default(false)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  user                     User                       @relation(fields: [userId], references: [id])
  expertise                AstrologerExpertise[]
  reviews                  Review[]
  earnings                 AstrologerEarning[]
  payouts                  AstrologerPayout[]
  bankAccounts             AstrologerBankAccount[]
  savedKundlis             KundliSavedRecord[]
  liveSessions             LiveSession[]
  aiAstroPricing           AiAstroPricing?
  aiAstroUsages            AiAstroUsage[]
  aiAstroConversations     AiAstroConversation[]
  marketplaceSellerProfile MarketplaceSellerProfile?
  marketplaceProducts      MarketplaceProduct[]
  marketplaceSellerOrders  MarketplaceSellerOrder[]   @relation("MarketplaceSellerOrders")
  marketplaceEarnings      MarketplaceSellerEarning[]
  marketplacePayouts       MarketplaceSellerPayout[]

  @@index([userId])
  @@index([isApproved])
  @@index([isVerified])
  @@index([isOnline])
  @@index([rating])
}

model Expertise {
  id          String                @id @default(uuid())
  name        String                @unique
  astrologers AstrologerExpertise[]
}

model AstrologerExpertise {
  id           String     @id @default(uuid())
  astrologerId String
  expertiseId  String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])
  expertise    Expertise  @relation(fields: [expertiseId], references: [id])

  @@unique([astrologerId, expertiseId])
}

model Review {
  id            String      @id @default(uuid())
  astrologerId  String
  userId        String
  callSessionId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  astrologer    Astrologer  @relation(fields: [astrologerId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@index([astrologerId])
  @@index([userId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model Profile {
  id            String   @id @default(uuid())
  userId        String
  name          String
  gender        Gender
  lat           Float
  lon           Float
  timezone      Float
  createdAt     DateTime @default(now())
  birthDate     DateTime
  birthTime     String
  isDeleted     Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  lang          String   @default("en")
  city          String?
  countryCode   String?
  country       String?
  fullname      String?
  state         String?
  timezoneName  String?
  avatarUrl     String?
  maritalStatus String?
  occupation    String?
  matchesAsBoy  Match[]  @relation("Boy")
  matchesAsGirl Match[]  @relation("Girl")
  user          User     @relation("UserProfiles", fields: [userId], references: [id])

  @@index([userId])
}

model Match {
  id        String   @id @default(uuid())
  score     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  status    String   @default("PENDING")
  summary   String?
  boyId     String
  girlId    String
  isSaved   Boolean  @default(false)
  result    Json?
  boy       Profile  @relation("Boy", fields: [boyId], references: [id])
  girl      Profile  @relation("Girl", fields: [girlId], references: [id])

  @@unique([boyId, girlId])
  @@index([boyId])
  @@index([girlId])
}

model KundliData {
  id               String   @id @default(cuid())
  apiVersion       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  currentMahaDasha Json?
  kundliId         String   @unique
  lang             String   @default("en")
  vedic            Json?
  kundli           Kundli   @relation(fields: [kundliId], references: [id])

  @@unique([kundliId, lang])
}

model Kundli {
  id           String              @id @default(cuid())
  latitude     Float
  longitude    Float
  createdAt    DateTime            @default(now())
  timezone     Float
  hash         String              @unique
  dob          String
  tob          String
  data         KundliData?
  orders       KundliOrder[]
  savedRecords KundliSavedRecord[]
}

model KundliSavedRecord {
  generationRequests    KundliGenerationRequest[]
  id                    String                    @id @default(cuid())
  kundliId              String
  createdByAstrologerId String
  customerUserId        String?
  name                  String
  gender                Gender?
  birthPlace            String?
  lang                  String                    @default("en")
  idempotencyKey        String                    @unique
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  kundli              Kundli     @relation(fields: [kundliId], references: [id], onDelete: Cascade)
  createdByAstrologer Astrologer @relation(fields: [createdByAstrologerId], references: [id], onDelete: Cascade)
  customerUser        User?      @relation(fields: [customerUserId], references: [id], onDelete: SetNull)

  @@index([kundliId])
  @@index([createdByAstrologerId, createdAt])
  @@index([customerUserId, createdAt])
  @@map("kundli_saved_records")
}

model Subscription {
  expiryReminders SubscriptionExpiryReminder[]
  horoscopeControl       HoroscopeSubscriptionControl?
  horoscopeAudit         HoroscopeSubscriptionAudit[]
  horoscopeReadings      PersonalizedHoroscopeReading[]
  horoscopeOutbox        HoroscopeNotificationOutbox[]
  id                     String                         @id @default(uuid())
  userId                 String
  subscriptionPlanId     String?
  subscriptionStatus     SubscriptionStatus             @default(FREE)
  amount                 Decimal?                       @db.Decimal(12, 3)
  currency               String                         @default("INR")
  razorpaySubscriptionId String?                        @unique
  razorpayCustomerId     String?
  razorpayPaymentId      String?
  razorpayOrderId        String?
  startDate              DateTime?
  endDate                DateTime?
  nextBillingAt          DateTime?
  isTrial                Boolean                        @default(false)
  cancelledAt            DateTime?
  expiredAt              DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  subscriptionPlan       SubscriptionPlan?              @relation(fields: [subscriptionPlanId], references: [id])
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionStatus])
  @@index([subscriptionPlanId])
  @@unique([id, userId], map: "Subscription_id_userId_key")
}

model SubscriptionPlan {
  id             String         @id @default(uuid())
  name           String         @unique
  displayName    String
  description    String?
  price          Decimal        @db.Decimal(12, 3)
  currency       String         @default("INR")
  durationDays   Int
  features       Json?
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  razorpayPlanId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
  users          User[]
}

model SubscriptionReminderPreference {
  userId String
  roleContext String
  pushEnabled Boolean @default(false)
  timezone String @default("UTC")
  quietStart Int @default(22)
  quietEnd Int @default(8)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([userId, roleContext])
}

model SubscriptionExpiryReminder {
  id String @id
  subscriptionId String
  userId String
  roleContext String
  expiresAt DateTime @db.Timestamptz(6)
  milestone Int
  channel String
  deviceId String @default("")
  state String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  leaseUntil DateTime? @db.Timestamptz(6)
  lastCode String?
  readAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  subscription Subscription @relation(fields: [subscriptionId,userId], references: [id,userId], onDelete: Cascade, onUpdate: NoAction, map: "SubscriptionExpiryReminder_subscription_owner_fkey")
  audits SubscriptionReminderAudit[]
  @@unique([subscriptionId,expiresAt,roleContext,milestone,channel,deviceId], map: "SubscriptionExpiryReminder_dedupe_key")
  @@index([userId,roleContext,createdAt], map: "SubscriptionExpiryReminder_owner_idx")
  @@index([state,nextAttemptAt], map: "SubscriptionExpiryReminder_claim_idx")
}

model SubscriptionReminderAudit {
  id BigInt @id @default(autoincrement())
  reminderId String
  state String
  code String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  reminder SubscriptionExpiryReminder @relation(fields:[reminderId], references:[id], onDelete:Cascade, onUpdate:NoAction)
}

model Wallet {
  id            String         @id @default(cuid())
  userId        String         @unique
  balance       Decimal        @default(0) @db.Decimal(12, 2)
  paidBalance   Decimal        @default(0) @db.Decimal(12, 2)
  freeBalance   Decimal        @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal        @default(0) @db.Decimal(12, 2)
  currency      String         @default("INR")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  paymentOrders PaymentOrder[]
  ledgerEntries WalletLedger[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId], map: "wallets_id_owner_key")
  @@map("wallets")
}

model PaymentOrder {
  id                String        @id @default(cuid())
  userId            String
  walletId          String?
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique(map: "payment_orders_provider_payment_key")
  razorpaySignature String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  paymentMethod     String?
  status            PaymentStatus @default(PENDING)
  rawWebhook        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  type              PaymentType   @default(WALLET_RECHARGE)
  metadata          Json?
  creationCommand   PaymentCreationCommand?
  kundliOrder       KundliOrder?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet?       @relation(fields: [walletId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict, map: "payment_orders_wallet_owner_fkey")

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([type])
  @@map("payment_orders")
}

model KundliOrder {
  id             String            @id @default(cuid())
  userId         String
  paymentOrderId String            @unique
  kundliId       String?
  status         KundliOrderStatus @default(PENDING)
  pdfUrl         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  kundli         Kundli?           @relation(fields: [kundliId], references: [id])
  paymentOrder   PaymentOrder      @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletLedger {
  id            String               @id @default(cuid())
  walletId      String
  userId        String
  type          LedgerType
  amount        Decimal              @db.Decimal(12, 2)
  balanceBefore Decimal              @db.Decimal(12, 2)
  balanceAfter  Decimal              @db.Decimal(12, 2)
  referenceId   String?
  description   String?
  createdAt     DateTime             @default(now())
  referenceType LedgerReferenceType?
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@map("wallet_ledger")
}

model CallSession {
  feedbackContexts FeedbackContext[]
  birthSharing ConsultationBirthSharing?
  birthSharingAudits ConsultationBirthSharingAudit[]
  kundliConsents           KundliGenerationConsent[]
  kundliGenerationRequests KundliGenerationRequest[]
  financialPolicy          ConsultationFinancialPolicy?
  id                       String                       @id @default(cuid())
  userId                   String
  astrologerId             String
  channelName              String
  ratePerMinute            Float
  purchasedMinutes         Int
  extendedMinutes          Int                          @default(0)
  amountCharged            Float
  isFreeChat               Boolean                      @default(false)
  startedAt                DateTime
  expiresAt                DateTime
  endedAt                  DateTime?
  status                   String
  createdAt                DateTime                     @default(now())
  mode                     String                       @default("audio")
  astrologyQuestionId      String?
  astrologyQuestionText    String?
  astrologyCategorySlug    String?
  astrologer               User                         @relation("AstrologerCalls", fields: [astrologerId], references: [id])
  user                     User                         @relation("UserCalls", fields: [userId], references: [id])
  earning                  AstrologerEarning?
  messages                 ChatMessage[]
  review                   Review?
  kundliProfessionalReport AstrologerKundliReport?
}

// Optional relation preserves all historical CallSession scalar selections.
model ConsultationFinancialPolicy {
  callSessionId   String      @id
  platformPercent Decimal     @db.Decimal(5, 2)
  policyVersion   String
  lockedAt        DateTime    @default(now())
  lifecycle       String
  callSession     CallSession @relation(fields: [callSessionId], references: [id], onDelete: Restrict)
}

model CommissionPolicyAudit {
  id              String   @id
  actorUserId     String
  previousPercent Decimal  @db.Decimal(5, 2)
  newPercent      Decimal  @db.Decimal(5, 2)
  effectiveAt     DateTime
  createdAt       DateTime @default(now())

  @@index([effectiveAt])
}

model PaymentCreationCommand {
  id              String   @id
  userId          String
  scopeKey        String
  quoteHash       String
  providerMode    String
  amountMinor     BigInt
  currency        String
  state           String
  providerOrderId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentOrder    PaymentOrder? @relation(fields: [providerOrderId], references: [razorpayOrderId], onDelete: Restrict)

  @@index([userId, state])
}

model AdminFinanceAction {
  id           String   @id
  actorUserId  String
  action       String
  referenceId  String
  providerMode String
  reason       String
  requestKey   String   @unique
  state        String
  result       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  actor        User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([referenceId, createdAt])
}

model AstrologerEarning {
  id                 String                  @id @default(cuid())
  astrologerId       String
  callSessionId      String                  @unique
  payoutId           String?
  grossAmount        Decimal                 @db.Decimal(12, 2)
  platformFee        Decimal                 @default(0) @db.Decimal(12, 2)
  platformFeePercent Decimal                 @default(30) @db.Decimal(5, 2)
  netAmount          Decimal                 @db.Decimal(12, 2)
  currency           String                  @default("INR")
  status             AstrologerEarningStatus @default(PENDING)
  availableAt        DateTime?
  paidAt             DateTime?
  reversedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  astrologer         Astrologer              @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  callSession        CallSession             @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  payout             AstrologerPayout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([astrologerId])
  @@index([payoutId])
  @@index([status])
  @@index([createdAt])
  @@map("astrologer_earnings")
}

model AstrologerPayout {
  id            String  @id @default(cuid())
  astrologerId  String
  bankAccountId String?
  amount        Decimal @db.Decimal(12, 2)
  currency      String  @default("INR")

  // Payment presentation / gateway snapshot.
  // Existing currency/grandTotal remain the base marketplace order values.
  paymentCountryCode     String?
  paymentCurrency        String?
  paymentAmount          Decimal?               @db.Decimal(18, 6)
  paymentFxRate          Decimal?               @db.Decimal(18, 8)
  paymentFxQuotedAt      DateTime?
  razorpayAmountSubunits Decimal?               @db.Decimal(20, 0)
  status                 AstrologerPayoutStatus @default(REQUESTED)
  providerReference      String?
  idempotencyKey         String?                @unique
  providerStatus         String?
  providerStatusDetails  Json?
  lastWebhookAt          DateTime?
  failureReason          String?
  requestedAt            DateTime               @default(now())
  processedAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  astrologer             Astrologer             @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  bankAccount            AstrologerBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  earnings               AstrologerEarning[]

  @@index([astrologerId])
  @@index([bankAccountId])
  @@index([status])
  @@index([createdAt])
  @@map("astrologer_payouts")
}

model AstrologerBankAccount {
  id           String @id @default(cuid())
  astrologerId String

  accountHolderName  String
  accountNumberLast4 String
  ifsc               String
  bankName           String?

  providerContactId     String? @unique
  providerFundAccountId String? @unique

